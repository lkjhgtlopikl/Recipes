{
  "name": "@recipes/recipes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "types": "tsc --noEmit --project ./tsconfig.json && tsc --noEmit --project ./tsconfig.node.json",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
